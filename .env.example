X_MODE=fake                     # fake: sample data, no keys needed · real: live X API
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8765/callback

# GitHub Token (for profile discovery, optional but recommended for rate limits)
GITHUB_TOKEN=

# Send channel: manual (0 USD, paste & send via X web) or api (X API v2)
SEND_CHANNEL=manual

# LLM Provider: ollama (local 0 USD), template (deterministic 0 USD), or anthropic
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b

ANTHROPIC_API_KEY=
LLM_MODEL=claude-fable-5-2
LLM_PRICE_IN=0                  # USD per million input tokens — copy from Anthropic's pricing page
LLM_PRICE_OUT=0
SEND_MODE=allowlist             # allowlist: only SEND_ALLOWLIST can receive · live: any approved prospect
SEND_ALLOWLIST=                 # comma-separated usernames
DAILY_SEND_CAP=20
